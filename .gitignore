# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
tools/cockpit/local/runs/

# M1.8 -- the local object store (STORAGE_ROOT). Uploaded bytes, never source.
var/

# Node
node_modules/
dist/

# Claude Code (machine-local)
.claude/settings.local*.json

# OS
.DS_Store

# Playwright run artifacts (§13's E2E layer). The reporters write these next to whatever
# directory the runner was invoked from -- `web/`, since `test:e2e` is an npm script there.
# `trace`/`video`/`screenshot` are all retain-on-failure, so these hold failure evidence:
# useful locally, never source.
test-results/
playwright-report/
blob-report/
.playwright/

# Playwright MCP scratch output (screenshots, snapshots, console logs).
.playwright-mcp/

# Working material for the judo technique library: the Kodokan's English definitions, read
# to write the Hebrew from. Never shipped and never committed — see
# scripts/fetch_judo_techniques.py.
**/.source-definitions.json

# Stitch MCP working output. The design that mattered is committed under
# docs/screenshots/upay-stub/ as provenance; this directory is tool cache.
.stitch/
