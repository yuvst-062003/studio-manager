# Copy to .env for local development. `.env` is gitignored; this file is not, which is
# safe because local Postgres uses trust auth and carries no credential.
#
# First: ./scripts/dev-db.sh up
ENV=development

DATABASE_URL=postgresql+psycopg://studio_app@127.0.0.1:55433/studio_manager
MIGRATION_DATABASE_URL=postgresql+psycopg://studio_migrator@127.0.0.1:55433/studio_manager
APP_DB_ROLE=studio_app

# Generate a key with:
#   .venv/bin/python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# In staging and production these come from Railway secrets and never from a file.
ENCRYPTION_KEYS={"1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
ENCRYPTION_ACTIVE_KEY_VERSION=1

LOG_LEVEL=INFO

# §19 -- who may call /dev/* on a deployed non-production environment. Empty here on
# purpose: local development has no auth layer yet, so an unset token means "this
# machine only". Staging is a public HTTPS origin and supplies its own value out of
# band (Railway secrets), because "the dev router exists there" must not mean "anyone
# may reset the demo studio or invent a payment there".
DEV_TOOLS_TOKEN=

# §5.10 / §15 item 2 -- the uPay merchant account a live payment form charges to.
# Empty here on purpose: development builds no live form (§19.6 means the demo studio
# raises instead), and a real merchant email in a committed file is an account
# identifier in git. Staging and production supply it from Railway variables.
UPAY_MERCHANT_EMAIL=

# The hosts a manager may paste a הוראת קבע link for, as a JSON array
# (e.g. ["pay.example.org"]). A link set on a price plan is shown to parents as the
# club's official payment page, so it must be https and its host must be on this list --
# a free-text URL field pointed at families is a phishing page with the club's name on it.
#
# Empty here on purpose, and empty means "our own payment provider": the allowlist falls
# back to uPay's host, read from the one place in app/ that names it. A club whose
# provider is someone else supplies this from Railway variables, which is deliberately a
# higher bar than a text box in the dashboard.
STANDING_ORDER_LINK_HOSTS=

# §5.2 -- the key this service signs its own access tokens with. HS256, because one
# service mints and the same service verifies. Generate:
#   .venv/bin/python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Staging and production supply it from Railway secrets, never from a file.
JWT_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# §5.2 -- Google is the working provider. Empty here: a real client id in a committed
# file is a console entry in git, and local sign-in runs against the fake provider that
# lives beside the real ones in app/services/identity/providers.py.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Sign in with Apple for the web needs an Apple Developer Program membership, which §6.5
# deliberately dropped when it dropped the store builds. Built, unconfigurable, tracked
# as HB-apple-developer -- the Apple button does not render while these are empty.
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# Where the provider redirects the browser back to. Must match the OAuth console's own
# allowlist exactly, or the flow fails with an error naming neither side.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# -- M1.8, object storage -----------------------------------------------------
# SPEC §4.3 has six `object_key` columns and no storage layer was ever scoped for them.
# app/core/storage.py is that layer, and the backend is a configuration value so moving
# to Cloudflare R2 later is these two lines and not a rewrite.
#
# `filesystem` everywhere today. In staging and production STORAGE_ROOT is a Railway
# volume mount path -- and a volume mounts to ONE service instance, so the API cannot be
# scaled horizontally while it is in use. Stated here rather than discovered at the
# replica count that breaks it.
STORAGE_BACKEND=filesystem
STORAGE_ROOT=var/storage

# -- operational alerting -----------------------------------------------------
# Self-contained on purpose: no Sentry, no Better Stack, no SDK and no account. The
# `job_run` heartbeat table plus the platform console at #/platform are the monitor; this
# block is the half that reaches somebody who is not looking at a screen.
#
# LEAVE THESE EMPTY and nothing is emailed -- and the console says "email delivery is off"
# in as many words rather than implying a channel that does not exist. An alerting system
# nobody has configured is worse than none, because it is believed.
#
# Any SMTP host works: Gmail with an app password, Fastmail, whatever already sends your
# mail. stdlib smtplib, so no Python dependency and no vendor. STARTTLS on 587 only --
# implicit TLS on 465 is deliberately unsupported, because choosing between them from a
# port number risks sending credentials in the clear.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# How long uPay may go without calling back before the console calls it a red signal.
# Wide, because a small club genuinely takes no online payment for days, and an alert that
# fires on a quiet week gets muted before it is ever right.
UPAY_CALLBACK_SILENCE_HOURS=72
